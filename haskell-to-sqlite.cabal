cabal-version:      3.0
name:               haskell-to-sqlite
version:            0.1.0.0
synopsis:           Deterministic flood susceptibility modeling for urban sub-basins
description:        A full-stack application that uses Haskell ADTs and pattern matching
                    to classify flood risk levels based on rainfall intensity, elevation,
                    and slope data for urban sub-basins.
license:            MIT
license-file:       LICENSE
author:             C S Deeraj
maintainer:         csdeeraj@gmail.com
category:           Database
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable flood-susceptibility
    import:           warnings
    main-is:          Main.hs
    other-modules:    Types
                    , FloodModel
                    , Database
                    , Api
    default-extensions: OverloadedStrings
                      , DeriveGeneric
    build-depends:    base >=4.17 && <5
                    , scotty >=0.12
                    , aeson >=2.0
                    , text >=1.2
                    , sqlite-simple >=0.4
                    , containers >=0.6
                    , bytestring >=0.11
                    , wai-middleware-static >=0.9
                    , http-types >=0.12
                    , time >=1.12
                    , warp >=3.3
                    , wai >=3.2
    hs-source-dirs:   backend
    default-language: Haskell2010
